@{
    ViewBag.Titulo = "Exclusão de Caixa";
}

@model ReservaMostrarViewModel;

<div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
    Deseja realmente cancelar essa reserva?
</div>

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
      asp-route-id="@Model.Id" method="post">

    <div class="mb-3">
        <label asp-for="Id" class="form-label fw-semibold text-primary text-uppercase small">Id</label>
        <input asp-for="Id" type="text" disabled class="form-control">
        <input asp-for="Id" type="hidden">
    </div>

    <div class="mb-3">
        <label asp-for="Amigo" class="form-label fw-semibold text-primary text-uppercase small">Amigo</label>
        <input asp-for="Amigo" type="text" disabled class="form-control">
        <input asp-for="Amigo" type="hidden">
    </div>

    <div class="mb-3">
        <label asp-for="Revista" class="form-label fw-semibold text-primary text-uppercase small">Revista</label>
        <input asp-for="Revista" type="text" disabled class="form-control">
        <input asp-for="Revista" type="hidden">
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">Data de reserva</label>
        <input asp-for="Data" type="text" disabled class="form-control">
        <input asp-for="Data" type="hidden">
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
