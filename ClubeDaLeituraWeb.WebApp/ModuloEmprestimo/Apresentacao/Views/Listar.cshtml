@{
    ViewBag.Titulo = "Listagem de Emprestimos";
}

@model List<EmprestimoMostrarViewModel>;

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">Cadastrar Novo</a>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhum emprestimo cadastrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle bg-white">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Amigo</th>
                    <th>Revista</th>
                    <th>Data de empréstimo</th>
                    <th>Data de devolução</th>
                    <th>Status</th>
                    <th>Multa</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.Id</td>
                        <td>@e.Amigo</td>
                        <td>@e.Revista</td>
                        <td>@e.DataEmprestimo.ToString("dd/MM/yyyy")</td>
                        <td>@e.DataDevolucao.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (e.StatusEmprestimo == StatusEmprestimo.Atrasado)
                            {
                                <strong>@e.StatusEmprestimo.String()</strong>
                            }
                            else
                            {
                                @e.StatusEmprestimo.String()
                            }
                        </td>
                        <td>
                            @if (e.StatusMulta == StatusMulta.Pendente)
                            {
                                <strong>@e.StatusMulta.String(): </strong><span>@e.Multa.ToString("C2")</span>
                            }
                            else
                            {
                                @e.StatusMulta.String()
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="Devolver" asp-route-id="@e.Id">Devolver</a>
                                @if (e.StatusMulta == StatusMulta.Pendente)
                                {
                                    <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="QuitarMulta" asp-route-id="@e.Id">Quitar Multa</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
