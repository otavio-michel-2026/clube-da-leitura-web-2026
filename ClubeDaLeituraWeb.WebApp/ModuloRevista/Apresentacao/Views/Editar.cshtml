@{
    ViewBag.Titulo = "Edição de Revista";
}

@model RevistaViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Editar"
      asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden">

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label fw-semibold text-primary text-uppercase small">Titulo</label>
        <input asp-for="Titulo" type="text" class="form-control">
        <span asp-validation-for="Titulo" class="text-danger small fw-semibold"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NumeroDeEdicao" class="form-label fw-semibold text-primary text-uppercase small">Numero da
            Edicao</label>
            <input asp-for="NumeroDeEdicao" type="number" class="form-control">
            <span asp-validation-for="NumeroDeEdicao" class="text-danger small fw-semibold"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AnoDePublicacao" class="form-label fw-semibold text-primary text-uppercase small">Ano de
                Publicacao</label>
                <input asp-for="AnoDePublicacao" type="number" class="form-control">
                <span asp-validation-for="AnoDePublicacao" class="text-danger small fw-semibold"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Caixa" class="form-label fw-semibold text-primary text-uppercase small">Caixa</label>
                <input asp-for="Caixa" type="number" class="form-control">
                <span asp-validation-for="Caixa" class="text-danger small fw-semibold"></span>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
                <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
            </div>
        </form>
