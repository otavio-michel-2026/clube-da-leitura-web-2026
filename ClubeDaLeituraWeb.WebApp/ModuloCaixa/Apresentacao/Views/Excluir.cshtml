@{
    ViewBag.Titulo = "Exclusão de Caixa";
}

@model CaixaMostrarViewModel;

<div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
    Deseja realmente excluir essa caixa?
</div>

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
      asp-route-id="@Model.Id" method="post">

    @if (ViewBag.Erro is string)
    {
        <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
            @ViewBag.Erro
        </div>
    }

    <div class="mb-3">
        <label asp-for="Id" class="form-label fw-semibold text-primary text-uppercase small">Id</label>
        <input asp-for="Id" type="text" disabled class="form-control">
        <input asp-for="Id" type="hidden">
    </div>

    <div class="mb-3">
        <label asp-for="Etiqueta" class="form-label fw-semibold text-primary text-uppercase small">Etiqueta</label>
        <input asp-for="Etiqueta" type="text" disabled class="form-control">
        <input asp-for="Etiqueta" type="hidden">
    </div>

    <div class="mb-3">
        <label asp-for="Cor" class="form-label fw-semibold text-primary text-uppercase small">Cor</label>
        <input asp-for="Cor" type="text" disabled class="form-control">
        <input asp-for="Cor" type="hidden">
    </div>

    <div class="mb-3">
        <label asp-for="DiasDeEmprestimo" class="form-label fw-semibold text-primary text-uppercase small">Dias de
            Empréstimo</label>
            <input asp-for="DiasDeEmprestimo" type="text" disabled class="form-control">
            <input asp-for="DiasDeEmprestimo" type="hidden">
        </div>

        <div class="mb-3">
            <label asp-for="QtdRevistas" class="form-label fw-semibold text-primary text-uppercase small">Quantidade de
                Revistas</label>
                <input asp-for="QtdRevistas" type="text" disabled class="form-control">
                <input asp-for="QtdRevistas" type="hidden">
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
                <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
            </div>
        </form>
